# =============================================================================
# Nginx do frontend: serve o SPA e faz proxy de /api/ para o backend.
#
# Este arquivo é um template do entrypoint oficial da imagem nginx: na
# inicialização, o envsubst troca apenas as variáveis de ambiente API_UPSTREAM
# e NGINX_RESOLVER (ver NGINX_ENVSUBST_FILTER no Dockerfile) e grava o resultado em
# /etc/nginx/conf.d/default.conf. As variáveis do próprio nginx ($uri, $1,
# $host, $api_upstream...) não estão no ambiente e ficam intactas.
# =============================================================================

server {
    listen 80;
    server_name _;
    server_tokens off;

    root /usr/share/nginx/html;
    index index.html;

    # ---- Compressão --------------------------------------------------------
    gzip on;
    gzip_vary on;
    gzip_proxied any;
    gzip_comp_level 5;
    gzip_min_length 1024;
    gzip_types text/plain text/css text/javascript application/javascript application/json image/svg+xml;

    # ---- Proxy da API ------------------------------------------------------
    # DNS consultado em tempo de requisição (127.0.0.11 = DNS embutido do Docker).
    # Como o destino fica numa variável, o nginx sobe mesmo que o backend ainda
    # não exista; o nome é resolvido a cada requisição (cache de 30s).
    resolver ${NGINX_RESOLVER} valid=30s ipv6=off;
    resolver_timeout 5s;

    location /api/ {
        set $api_upstream ${API_UPSTREAM};

        # Remove o prefixo /api: /api/books?x=1 -> /books?x=1 no backend
        rewrite ^/api/(.*)$ /$1 break;
        proxy_pass $api_upstream;

        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host $http_host;
        proxy_set_header X-Forwarded-Prefix /api;

        # O navegador envia o header Origin em POST/PUT/PATCH/DELETE mesmo sendo same-origin.
        # Repassado ao back, ele vira uma requisição CORS e o Spring responde 403 "Invalid CORS
        # request" quando o front é acessado por uma origem não liberada (ex.: 127.0.0.1 ou o IP
        # da rede). Pelo proxy a chamada é same-origin para o navegador, então o header é
        # removido (valor vazio = não repassado), como já faz o proxy do vite.config.ts.
        proxy_set_header Origin "";

        proxy_connect_timeout 5s;
        proxy_read_timeout 60s;
    }

    # ---- Arquivos estáticos ------------------------------------------------
    # Assets gerados pelo Vite têm hash no nome: podem ficar em cache "para sempre".
    location /assets/ {
        add_header Cache-Control "public, max-age=31536000, immutable" always;
        try_files $uri =404;
    }

    # index.html nunca deve ficar em cache, para o navegador pegar o deploy novo.
    location = /index.html {
        add_header Cache-Control "no-cache" always;
        try_files $uri =404;
    }

    # Fallback do SPA: rotas desconhecidas devolvem o index.html.
    location / {
        try_files $uri $uri/ /index.html;
    }
}
