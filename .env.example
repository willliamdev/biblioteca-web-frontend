# Copie para .env.local e ajuste conforme o ambiente.

# URL base usada pelo navegador para chamar a API.
# Com "/api", as requisições passam pelo proxy (Vite em dev/preview, Nginx em produção),
# que remove o prefixo /api antes de repassar ao backend.
VITE_API_URL=/api

# Destino do proxy do Vite (npm run dev / npm run preview). Padrão: http://localhost:8080
VITE_PROXY_TARGET=http://localhost:8080
